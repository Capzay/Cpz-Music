# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project settings > API. The anon key is safe in the browser (RLS protects the
# data). The service role key is not: it bypasses RLS and can write app_metadata.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Database ──────────────────────────────────────────────────────────────────
# Dashboard → Connect → Session pooler (port 5432). Do not use the direct
# db.*.supabase.co host: it is IPv6-only, and a typical home Pi has no IPv6
# route. Session mode (5432), not transaction mode (6543) — Prisma uses
# prepared statements. Username is postgres.<project-ref>, not postgres.
DATABASE_URL="postgresql://postgres.your-project:password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ── Access ────────────────────────────────────────────────────────────────────
# Your GitHub account's immutable numeric id, from https://api.github.com/users/<username>
# Only this account can reach the library. Unset means nobody gets in.
OWNER_GITHUB_ID=""

# ── Library ───────────────────────────────────────────────────────────────────
# Absolute path to your music. Read-only; nothing is ever written here.
MUSIC_DIR="/home/you/Music"
# Where extracted album art is cached.
ARTWORK_DIR="./.artwork"

# ── Signing ───────────────────────────────────────────────────────────────────
# Signs jam invite links and OBS overlay links. Minimum 32 characters.
# Generate with: openssl rand -hex 32
# Rotating this invalidates every outstanding invite and overlay link.
APP_SECRET=""
