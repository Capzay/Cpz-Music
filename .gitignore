# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Secrets live in .env.local; only the placeholder template is tracked.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client
/src/generated

# extracted album art cache
/.artwork

# nothing from the music library belongs in git
*.mp3
*.flac
*.m4a
*.ogg
*.opus
*.wav
*.aac

# android / electron build output
/android/app/build
/android/.gradle
/electron/dist
