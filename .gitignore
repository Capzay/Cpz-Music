# Build output
/target
# Installers and APKs from scripts/package-client.sh and `cargo android`
/dist

# Env files. Secrets live in .env.local; only the placeholder template is tracked.
.env*
!.env.example

# Server caches and builds, when run from the repo
/.artwork
/releases

# Nothing from the music library belongs in git
*.mp3
*.flac
*.m4a
*.ogg
*.opus
*.wav
*.aac

# Signing material must never be committed
*.pem
*.keystore
*.jks

.DS_Store
