// Colours, sizes and type in one place, so every screen agrees.

export global Theme {
    out property <color> bg: #0e0e11;
    out property <color> panel: #15151a;
    out property <color> raised: #1d1d24;
    out property <color> hover: #ffffff0f;
    out property <color> line: #ffffff14;
    out property <color> text: #f2f2f5;
    out property <color> muted: #9a9aa6;
    out property <color> faint: #5c5c68;
    out property <color> accent: #8b6cff;
    out property <color> accent-hover: #9d83ff;
    out property <color> danger: #ff6b6b;

    out property <length> radius: 8px;
    out property <length> gap: 16px;
    out property <length> page-padding: 28px;

    out property <length> size-small: 12px;
    out property <length> size-body: 14px;
    out property <length> size-title: 15px;
    out property <length> size-heading: 26px;
    out property <length> size-hero: 34px;
}
